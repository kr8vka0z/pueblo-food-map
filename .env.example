# Public (client) — safe to expose. Inlined into the client bundle at BUILD time by `next build`.
# For deploys these are GitHub Actions secrets, read by `next build` on the runner in
# deploy-dev.yml / deploy-prod.yml (see the Secrets table in AGENTS.md). Set them here only for local dev.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxx
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Dedicated invisible-mode Turnstile site key, blessing-box check-ins only.
# Never reuse NEXT_PUBLIC_TURNSTILE_SITE_KEY here — that key is managed-mode
# and still shows a checkbox on a real phone (Kyle, 2026-09-18); this one is
# provisioned in Cloudflare's own "invisible" widget mode instead.
NEXT_PUBLIC_TURNSTILE_BOX_SITE_KEY=
# PostHog project API key (#485). Build-time secret POSTHOG_PROJECT_KEY in
# GitHub Actions (deploy-dev.yml / deploy-prod.yml), not set here. Empty/unset
# is a supported, tested state — src/lib/analytics.ts's initAnalytics() never
# loads posthog-js at all without a key (local dev, tests, Lighthouse CI).
NEXT_PUBLIC_POSTHOG_KEY=

# Server-only — never commit real values. Read by the Worker at RUNTIME (request time), not at build time.
# Set as runtime Secrets: Settings → Variables and Secrets (encrypted secret_text), or `wrangler secret put`.
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
# Matching secret for NEXT_PUBLIC_TURNSTILE_BOX_SITE_KEY above — the box
# check-in route verifies against this by default. When a visitor fails the
# invisible check and the client falls back to the managed-mode widget
# (BoxCheckinPanel.tsx, "Fallback to a visible checkbox"), that one attempt
# verifies against TURNSTILE_SECRET_KEY above instead — no new secret to
# set for that case, since TURNSTILE_SECRET_KEY already exists.
TURNSTILE_BOX_SECRET_KEY=
# HMAC key for the blessing-box check-in rate limiter (src/lib/checkinRateLimit.ts).
# Dedicated on purpose — never reuse TURNSTILE_SECRET_KEY here, or rotating Turnstile
# for an unrelated reason silently resets every open rate-limit bucket.
CHECKIN_RATE_LIMIT_SECRET=

# Dev scripts only (scripts/geocode-osm-missing.py): the Mapbox
# full-scope (sk) token used for reverse-geocoding. Never in the client bundle. Provide it as a
# 1Password reference in a gitignored .env.local and run scripts via `op run --env-file=.env.local`.
MAPBOX_TOKEN=

# Better Auth — runtime, server-only. Signs/encrypts admin sessions, emailed
# sign-in codes and passkey challenges; all state lives in the ADMIN_DB D1
# database (no Workers KV). Better Auth (6-digit email code + passkey) is the
# only admin gate. Generate a local dev value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Store it in .env.local (gitignored). Deployed Workers read it as a Worker
# secret (`wrangler secret put BETTER_AUTH_SECRET`).
BETTER_AUTH_SECRET=

# Admin allowlist (#315 Phase 2) — runtime, server-only. Comma-separated
# email addresses permitted to hold an admin session at all; enforced at
# every Better Auth hook that can mint one (src/lib/adminAuthAllowlistPlugin.ts).
# Trimmed + lower-cased before comparison. If unset (or resolves to zero
# entries), src/lib/adminAllowlist.ts falls back to ["kysboyd@gmail.com"] —
# fails toward "only Kyle," never toward "everyone."
ADMIN_ALLOWLIST=kysboyd@gmail.com

# Optional runtime secrets — each fails soft when unset, so local dev runs without them.
# CF_ANALYTICS_API_TOKEN: Account Analytics read-only. Unset → the admin Dashboard's
# Visitors section shows "unavailable"; the rest of the page renders.
# CF_ANALYTICS_API_TOKEN=
# POSTHOG_PERSONAL_API_KEY: read-only PostHog query key. Unset → the admin Dashboard's
# "What people do on the map" section shows "unavailable"; the rest renders.
# POSTHOG_PERSONAL_API_KEY=
# GITHUB_PUBLISH_TOKEN: fine-grained PAT (this repo; Contents + Pull requests RW).
# Publish only runs on the prod Worker (403 elsewhere); there, unset → Publish answers 503.
# GITHUB_PUBLISH_TOKEN=

# HC_PING_URL is not listed on purpose: it is a prod-only `wrangler secret`, never set locally or on staging.
